# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/agentika
MONGODB_USER=
MONGODB_PASSWORD=

# JWT
JWT_SECRET=change_this_in_production_use_long_random_string
JWT_REFRESH_SECRET=change_this_in_production_use_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://localhost:5173

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=agentika-media
MINIO_PUBLIC_URL=http://localhost:9000/agentika-media

# Email Configuration
MAIL_PROVIDER=imap_smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@example.com
IMAP_PASS=your-password

# Public URLs
APP_PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Seed Admin
SEED_ADMIN_EMAIL=admin@agentika.com
SEED_ADMIN_PASSWORD=admin123

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif,webp
