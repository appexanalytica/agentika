# Server Config
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agentika
MONGODB_USER=
MONGODB_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=agentika
MINIO_USE_SSL=false

# JWT
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRE=7d

# Seed Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@tudominio.com

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5000

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif

# Mail Configuration
MAIL_ADDRESS=correo@tudominio.com
MAIL_PASSWORD=contraseña_segura
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
IMAP_HOST=imap.tudominio.com
IMAP_PORT=993
IMAP_SECURE=true
MAIL_FROM="Panel Administrador <correo@tudominio.com>"
